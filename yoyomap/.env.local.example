# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-keep-secret  # mark Sensitive in Vercel

# Resend (transactional email)
RESEND_API_KEY=your-resend-key  # mark Sensitive in Vercel
