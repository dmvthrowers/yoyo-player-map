# ============================================================
# YoYo Player Map — environment variables template
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local — it is listed in .gitignore.
# ============================================================

# --- Supabase (public) ---
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# --- Supabase (server-only) ---
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# --- Upstash Redis (for rate limiting) ---
UPSTASH_REDIS_REST_URL=https://<your-redis-instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-redis-token>

# --- Resend (transactional email, server-only) ---
RESEND_API_KEY=re_<your-resend-key>
EMAIL_FROM="YoYo Map <noreply@example.com>"

# --- App URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Secrets (generate with: openssl rand -hex 32) ---
ADMIN_PASSWORD=<change-me-strong-random-password>
ENTRY_SECRET=<change-me-32-char-random-secret>
CRON_SECRET=<change-me-hex-64-random-secret>
REVALIDATE_SECRET=<change-me-hex-64-random-secret>

# --- Sentry error reporting (optional; off when unset) ---
# One DSN serves browser and server. Errors only: no tracing or replay.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for readable stack traces (source map upload):
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Cloudflare Turnstile on /submit and /report (optional; off when unset) ---
# Set both together: the site key renders the widget, the secret verifies it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Uptime monitor deep check: /api/health?deep=1&token=... (optional) ---
HEALTHCHECK_TOKEN=<change-me-hex-32-random-secret>
